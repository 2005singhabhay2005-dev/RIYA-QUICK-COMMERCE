# ==========================================================
# RIYA QUICK COMMERCE API - ENVIRONMENT TEMPLATE
# ==========================================================

# Server
PORT=5000

# SQLite database
# Production host par persistent writable storage path use karein.
DATABASE_FILE=./data/riya-commerce.db

# Frontend URLs
STOREFRONT_URL=https://your-storefront-domain.example
ADMIN_URL=https://your-admin-domain.example

# Authentication
# Generate a long random value. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret

# Admin bootstrap / authentication
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# SMTP / customer email OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-email@example.com
SMTP_PASS=replace-with-smtp-app-password
SMTP_FROM=your-smtp-email@example.com
